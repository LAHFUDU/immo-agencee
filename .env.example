# ---- Copy to .env next to docker-compose.yml. NEVER commit the real .env. ----
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=production
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_USER=immo
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=immo

# Local test on your machine:    SITE_ADDRESS=:80                PUBLIC_URL=http://localhost   COOKIE_SECURE=false
# Production (automatic HTTPS):  SITE_ADDRESS=agence.example.com PUBLIC_URL=https://agence.example.com COOKIE_SECURE=true
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
COOKIE_SECURE=false

WEB_CONCURRENCY=3
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=INFO

# Optional: file storage on any S3-compatible bucket (AWS S3, Scaleway, OVH, MinIO...)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: e-mail notifications & invitation e-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
