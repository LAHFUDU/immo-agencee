# Native development (uvicorn on your machine). Copy to backend/.env and adapt.
ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql+psycopg://immo@localhost:5434/immo
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
UPLOAD_DIR=uploads
# SMTP is optional: without it the app shows invitation links on screen and sends no e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
